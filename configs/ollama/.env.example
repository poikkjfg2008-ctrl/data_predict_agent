# Ollama endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Chat model used by agent (must exist locally: `ollama list`)
OLLAMA_CHAT_MODEL=qwen2.5:7b

# Optional planner model (if your agent uses planner/executor split)
OLLAMA_PLANNER_MODEL=qwen2.5:14b

# Generation settings
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9
OLLAMA_NUM_CTX=8192
OLLAMA_MAX_TOKENS=1024
OLLAMA_TIMEOUT_SECONDS=120

# Optional auth header for reverse-proxy deployments
OLLAMA_API_KEY=

# Agent provider switch
AGENT_LLM_PROVIDER=ollama
