# -----------------------------
# Agent LLM Provider Selection
# -----------------------------
LLM_PROVIDER=ollama

# Ollama endpoint
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b

# Optional auth for OpenAI-compatible gateways
LLM_API_KEY=

# Generation settings
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_MAX_TOKENS=1024

# Optional fallback provider (set when you want failover)
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
