# ===== Ollama service =====
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_HEALTH_ENDPOINT=/api/tags

# ===== Default model selection =====
OLLAMA_PLANNER_MODEL=qwen2.5:7b
OLLAMA_EXECUTOR_MODEL=qwen2.5:7b
OLLAMA_FALLBACK_MODEL=llama3.1:8b

# ===== Request behavior =====
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=3
OLLAMA_RETRY_BACKOFF_SECONDS=2

# ===== Generation defaults =====
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024

# ===== Optional auth/proxy =====
# OLLAMA_API_KEY=
# OLLAMA_PROXY_URL=
